rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner() {
      return isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    function rolePath(uid) {
      return /databases/$(database)/documents/forumUserRoles/$(uid);
    }

    function roleExists(uid) {
      return exists(rolePath(uid));
    }

    function roleDoc(uid) {
      return get(rolePath(uid));
    }

    function isTrustedCreator(uid) {
      return roleExists(uid) && (
        (('trustedCreator' in roleDoc(uid).data) && roleDoc(uid).data.trustedCreator == true)
        ||
        (('reputation' in roleDoc(uid).data)
          && roleDoc(uid).data.reputation is number
          && roleDoc(uid).data.reputation >= 250)
      );
    }

    function isBanned(uid) {
      return roleExists(uid)
        && ('isBanned' in roleDoc(uid).data)
        && roleDoc(uid).data.isBanned == true;
    }

    function hasThreadRestriction(uid) {
      return roleExists(uid)
        && ('threadRestrictedUntil' in roleDoc(uid).data)
        && roleDoc(uid).data.threadRestrictedUntil is timestamp
        && roleDoc(uid).data.threadRestrictedUntil > request.time;
    }

    function hasCommentRestriction(uid) {
      return roleExists(uid)
        && ('commentRestrictedUntil' in roleDoc(uid).data)
        && roleDoc(uid).data.commentRestrictedUntil is timestamp
        && roleDoc(uid).data.commentRestrictedUntil > request.time;
    }

    function hasThreadCooldown(uid) {
      return roleExists(uid)
        && ('threadCooldownUntil' in roleDoc(uid).data)
        && roleDoc(uid).data.threadCooldownUntil is timestamp
        && roleDoc(uid).data.threadCooldownUntil > request.time;
    }

    function hasCommentCooldown(uid) {
      return roleExists(uid)
        && ('commentCooldownUntil' in roleDoc(uid).data)
        && roleDoc(uid).data.commentCooldownUntil is timestamp
        && roleDoc(uid).data.commentCooldownUntil > request.time;
    }

    function canCreateThread() {
      return isVerifiedUser()
        && !isBanned(request.auth.uid)
        && !hasThreadRestriction(request.auth.uid)
        && !hasThreadCooldown(request.auth.uid);
    }

    function canCreateComment() {
      return isVerifiedUser()
        && !isBanned(request.auth.uid)
        && !hasCommentRestriction(request.auth.uid)
        && !hasCommentCooldown(request.auth.uid);
    }

    function canCreateNormalCategory() {
      return isAdmin() || (isVerifiedUser() && isTrustedCreator(request.auth.uid));
    }

    function categoryPath(categoryId) {
      return /databases/$(database)/documents/forumCategories/$(categoryId);
    }

    function categoryExists(categoryId) {
      return exists(categoryPath(categoryId));
    }

    function categoryDoc(categoryId) {
      return get(categoryPath(categoryId));
    }

    function categoryIsActive(categoryId) {
      return categoryExists(categoryId)
        && (
          !('isArchived' in categoryDoc(categoryId).data)
          || categoryDoc(categoryId).data.isArchived == false
        );
    }

    function categoryMatchesType(categoryId, categoryType) {
      return categoryIsActive(categoryId)
        && ('type' in categoryDoc(categoryId).data)
        && categoryDoc(categoryId).data.type == categoryType;
    }

    function threadPath(threadId) {
      return /databases/$(database)/documents/forumThreads/$(threadId);
    }

    function threadExists(threadId) {
      return exists(threadPath(threadId));
    }

    function threadDoc(threadId) {
      return get(threadPath(threadId));
    }

    function threadCanReceiveComments(threadId) {
      return threadExists(threadId)
        && (
          !('isLocked' in threadDoc(threadId).data)
          || threadDoc(threadId).data.isLocked == false
        )
        && (
          isAdmin()
          || threadDoc(threadId).data.moderationStatus == 'visible'
          || (isSignedIn() && threadDoc(threadId).data.authorUid == request.auth.uid)
        );
    }

    function validModerationStatus(value) {
      return value == 'visible' || value == 'pending' || value == 'hidden';
    }

    function validCategoryType(value) {
      return value == 'normal' || value == 'admin';
    }

    function validForumCategoryPayload() {
      return request.resource.data.keys().hasOnly([
          'name',
          'slug',
          'description',
          'type',
          'isArchived',
          'createdByUid',
          'createdByName',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'slug',
          'type',
          'isArchived',
          'createdByUid',
          'createdByName',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 70
        && request.resource.data.slug is string
        && request.resource.data.slug.size() >= 2
        && request.resource.data.slug.size() <= 70
        && (!('description' in request.resource.data)
          || (request.resource.data.description is string
            && request.resource.data.description.size() <= 280))
        && validCategoryType(request.resource.data.type)
        && request.resource.data.isArchived == false
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 80
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validForumThreadCreatePayload() {
      return request.resource.data.keys().hasOnly([
          'title',
          'body',
          'categoryId',
          'categoryType',
          'authorUid',
          'authorName',
          'authorEmail',
          'authorIsAdmin',
          'isSticky',
          'isLocked',
          'moderationStatus',
          'commentCount',
          'createdAt',
          'updatedAt',
          'lastActivityAt'
        ])
        && request.resource.data.keys().hasAll([
          'title',
          'body',
          'categoryId',
          'categoryType',
          'authorUid',
          'authorName',
          'authorIsAdmin',
          'isSticky',
          'isLocked',
          'moderationStatus',
          'commentCount',
          'createdAt',
          'updatedAt',
          'lastActivityAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 6
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 12
        && request.resource.data.body.size() <= 8000
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.categoryId.size() <= 80
        && validCategoryType(request.resource.data.categoryType)
        && categoryMatchesType(request.resource.data.categoryId, request.resource.data.categoryType)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && (!('authorEmail' in request.resource.data)
          || request.resource.data.authorEmail == request.auth.token.email)
        && request.resource.data.authorIsAdmin == isAdmin()
        && request.resource.data.isSticky is bool
        && (!request.resource.data.isSticky || isAdmin())
        && request.resource.data.isLocked == false
        && validModerationStatus(request.resource.data.moderationStatus)
        && (isAdmin() || request.resource.data.moderationStatus != 'hidden')
        && request.resource.data.commentCount is number
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActivityAt == request.time;
    }

    function validForumThreadUpdateByOwner() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'title',
          'body',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 6
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 12
        && request.resource.data.body.size() <= 8000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorEmail == resource.data.authorEmail
        && request.resource.data.authorIsAdmin == resource.data.authorIsAdmin
        && request.resource.data.categoryId == resource.data.categoryId
        && request.resource.data.categoryType == resource.data.categoryType
        && request.resource.data.isSticky == resource.data.isSticky
        && request.resource.data.isLocked == resource.data.isLocked
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastActivityAt == resource.data.lastActivityAt
        && resource.data.isLocked != true;
    }

    function validForumThreadUpdateByAdmin() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'title',
          'body',
          'categoryId',
          'categoryType',
          'isSticky',
          'isLocked',
          'moderationStatus',
          'commentCount',
          'updatedAt',
          'lastActivityAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 6
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 12
        && request.resource.data.body.size() <= 8000
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.categoryId.size() <= 80
        && validCategoryType(request.resource.data.categoryType)
        && categoryMatchesType(request.resource.data.categoryId, request.resource.data.categoryType)
        && request.resource.data.isSticky is bool
        && request.resource.data.isLocked is bool
        && validModerationStatus(request.resource.data.moderationStatus)
        && request.resource.data.commentCount is number
        && request.resource.data.commentCount >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActivityAt is timestamp
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorEmail == resource.data.authorEmail
        && request.resource.data.authorIsAdmin == resource.data.authorIsAdmin
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validForumCommentPayload() {
      return request.resource.data.keys().hasOnly([
          'body',
          'authorUid',
          'authorName',
          'authorEmail',
          'authorIsAdmin',
          'moderationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'body',
          'authorUid',
          'authorName',
          'authorIsAdmin',
          'moderationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1500
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && (!('authorEmail' in request.resource.data)
          || request.resource.data.authorEmail == request.auth.token.email)
        && request.resource.data.authorIsAdmin == isAdmin()
        && validModerationStatus(request.resource.data.moderationStatus)
        && (isAdmin() || request.resource.data.moderationStatus != 'hidden')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validForumCommentUpdateByOwner() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'body',
          'updatedAt'
        ])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1500
        && request.resource.data.updatedAt == request.time
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorEmail == resource.data.authorEmail
        && request.resource.data.authorIsAdmin == resource.data.authorIsAdmin
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validForumCommentUpdateByAdmin() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'body',
          'moderationStatus',
          'updatedAt'
        ])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1500
        && validModerationStatus(request.resource.data.moderationStatus)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorEmail == resource.data.authorEmail
        && request.resource.data.authorIsAdmin == resource.data.authorIsAdmin
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validForumRolePayload() {
      return request.resource.data.keys().hasOnly([
          'trustedCreator',
          'reputation',
          'isBanned',
          'threadRestrictedUntil',
          'commentRestrictedUntil',
          'threadCooldownUntil',
          'commentCooldownUntil',
          'reason',
          'updatedAt',
          'updatedByUid'
        ])
        && (!('trustedCreator' in request.resource.data)
          || request.resource.data.trustedCreator is bool)
        && (!('reputation' in request.resource.data)
          || (request.resource.data.reputation is number
            && request.resource.data.reputation >= 0
            && request.resource.data.reputation <= 1000000))
        && (!('isBanned' in request.resource.data)
          || request.resource.data.isBanned is bool)
        && (!('threadRestrictedUntil' in request.resource.data)
          || request.resource.data.threadRestrictedUntil is timestamp)
        && (!('commentRestrictedUntil' in request.resource.data)
          || request.resource.data.commentRestrictedUntil is timestamp)
        && (!('threadCooldownUntil' in request.resource.data)
          || request.resource.data.threadCooldownUntil is timestamp)
        && (!('commentCooldownUntil' in request.resource.data)
          || request.resource.data.commentCooldownUntil is timestamp)
        && (!('reason' in request.resource.data)
          || (request.resource.data.reason is string
            && request.resource.data.reason.size() <= 300))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function validModerationActionPayload() {
      return request.resource.data.keys().hasOnly([
          'actionType',
          'targetUid',
          'threadId',
          'commentId',
          'reason',
          'details',
          'createdAt',
          'createdByUid'
        ])
        && request.resource.data.keys().hasAll([
          'actionType',
          'targetUid',
          'createdAt',
          'createdByUid'
        ])
        && request.resource.data.actionType is string
        && request.resource.data.actionType.size() > 0
        && request.resource.data.actionType.size() <= 60
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() > 0
        && request.resource.data.targetUid.size() <= 128
        && (!('threadId' in request.resource.data)
          || (request.resource.data.threadId is string && request.resource.data.threadId.size() > 0))
        && (!('commentId' in request.resource.data)
          || (request.resource.data.commentId is string && request.resource.data.commentId.size() > 0))
        && (!('reason' in request.resource.data)
          || (request.resource.data.reason is string && request.resource.data.reason.size() <= 300))
        && (!('details' in request.resource.data)
          || request.resource.data.details is map)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdByUid == request.auth.uid;
    }

    match /episodeComments/{episodeId}/items/{commentId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'body', 'authorUid', 'authorName', 'authorEmail', 'createdAt'
        ])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 500
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && (!('authorEmail' in request.resource.data)
            || request.resource.data.authorEmail == request.auth.token.email)
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin() || (
        isOwner()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['body'])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 500
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorEmail == resource.data.authorEmail
        && request.resource.data.createdAt == resource.data.createdAt
      );

      allow delete: if isOwner() || isAdmin();
    }

    match /forumCategories/{categoryId} {
      allow read: if true;

      allow create: if isSignedIn()
        && validForumCategoryPayload()
        && (
          (request.resource.data.type == 'admin' && isAdmin())
          || (request.resource.data.type == 'normal' && canCreateNormalCategory())
        );

      allow update, delete: if isAdmin();
    }

    match /forumThreads/{threadId} {
      allow read: if (
          resource.data.moderationStatus == 'visible'
          || isAdmin()
          || (isSignedIn() && request.auth.uid == resource.data.authorUid)
        );

      allow create: if canCreateThread()
        && validForumThreadCreatePayload()
        && (
          request.resource.data.categoryType == 'normal'
          || isAdmin()
        );

      allow update: if (
          isSignedIn()
          && request.auth.uid == resource.data.authorUid
          && validForumThreadUpdateByOwner()
        ) || (
          isAdmin() && validForumThreadUpdateByAdmin()
        );

      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.authorUid);

      match /comments/{commentId} {
        allow read: if threadExists(threadId)
          && (
            threadDoc(threadId).data.moderationStatus == 'visible'
            || isAdmin()
            || (isSignedIn() && threadDoc(threadId).data.authorUid == request.auth.uid)
          )
          && (
            resource.data.moderationStatus == 'visible'
            || isAdmin()
            || (isSignedIn() && request.auth.uid == resource.data.authorUid)
            || (isSignedIn() && threadDoc(threadId).data.authorUid == request.auth.uid)
          );

        allow create: if canCreateComment()
          && threadCanReceiveComments(threadId)
          && validForumCommentPayload();

        allow update: if (
            isSignedIn()
            && request.auth.uid == resource.data.authorUid
            && validForumCommentUpdateByOwner()
          ) || (
            isAdmin() && validForumCommentUpdateByAdmin()
          );

        allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.authorUid);
      }
    }

    match /forumUserRoles/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() && validForumRolePayload();
      allow delete: if isAdmin();
    }

    match /forumModerationActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validModerationActionPayload();
      allow update, delete: if false;
    }

    match /forumRateLimits/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
